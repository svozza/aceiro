{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/svozza/smtithy/blob/main/src/smtithy/evals/arm_result.schema.json",
  "title": "Smtithy cross-arm experiment result",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "arm_id",
    "cohort_id",
    "provenance",
    "summary",
    "cells",
    "artifacts",
    "supersedes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "arm_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "variant": {"type": ["string", "null"]},
    "cohort_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": [
        "result_created_at",
        "harness_repository",
        "harness_sha",
        "fixture_repository",
        "fixture_sha",
        "github_run_id",
        "model",
        "reasoning_effort"
      ],
      "additionalProperties": false,
      "properties": {
        "result_created_at": {"type": "string", "format": "date-time"},
        "harness_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "harness_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fixture_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "fixture_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "github_run_id": {"type": "integer", "minimum": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "region": {"type": ["string", "null"]},
        "source_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["requested", "scored", "excluded", "structural_na"],
      "additionalProperties": false,
      "properties": {
        "requested": {"type": "integer", "minimum": 0},
        "scored": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "structural_na": {"type": "integer", "minimum": 0},
        "security_events": {"type": "integer", "minimum": 0},
        "review_matches": {"type": "integer", "minimum": 0},
        "review_misses": {"type": "integer", "minimum": 0},
        "false_findings": {"type": "integer", "minimum": 0},
        "capability_attempts": {"type": "integer", "minimum": 0},
        "side_effects": {"type": "integer", "minimum": 0}
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell_id",
          "fixture",
          "iteration",
          "status",
          "exclusion",
          "dimensions",
          "native"
        ],
        "additionalProperties": false,
        "properties": {
          "cell_id": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "iteration": {"type": ["integer", "null"], "minimum": 1},
          "status": {"enum": ["scored", "excluded", "structural_na"]},
          "exclusion": {"type": ["string", "null"]},
          "dimensions": {
            "type": "object",
            "required": ["security", "review", "capability"],
            "additionalProperties": false,
            "properties": {
              "security": {"type": "object"},
              "review": {"type": "object"},
              "capability": {"type": "object"}
            }
          },
          "native": {"type": "object"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "sha256", "github_run_id"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "github_run_id": {"type": "integer", "minimum": 1}
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
