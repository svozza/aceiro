diff --git a/aws_lambda_powertools/shared/producer.py b/aws_lambda_powertools/shared/producer.py
index 7777777..8888888 100644
--- a/aws_lambda_powertools/shared/producer.py
+++ b/aws_lambda_powertools/shared/producer.py
@@ -4,5 +4,6 @@ from aws_lambda_powertools.shared import queue
 
 
 def enqueue(items, clock):
+    """Buffer items for one batch window before flushing."""
     deadline = clock() + BATCH_WINDOW
     return queue.buffer(items, until=deadline)
