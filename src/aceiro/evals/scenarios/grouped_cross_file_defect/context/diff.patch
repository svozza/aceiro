diff --git a/aws_lambda_powertools/shared/consumer.py b/aws_lambda_powertools/shared/consumer.py
index 3333333..4444444 100644
--- a/aws_lambda_powertools/shared/consumer.py
+++ b/aws_lambda_powertools/shared/consumer.py
@@ -4,5 +4,6 @@ from aws_lambda_powertools.shared import queue
 
 
 def drain(sink, clock):
+    """Drain whatever the producer buffered in the last window."""
     since = clock() - BATCH_WINDOW
     return queue.drain_since(sink, since)
