{
  "version": 1,
  "description": "Declarative safety policy for AI review artifacts. artifact_schema and plan.schema are standard JSON Schema Draft 2020-12 documents consumed directly by the generators and deterministic verifiers. The remaining fields configure contextual checks JSON Schema cannot decide from the candidate object alone: Markdown rendering, diff provenance, secret scanning, effect classification, ordering, containment, and aggregate change budgets. The file's sha256 is stamped into the transcript and posted comment. The default is deliberately fail-closed: link_host_allowlist and plan.label_allowlist ship empty, and plan.branch_prefix confines pushed branches to a harness-owned namespace.",
  "artifact_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
      "findings": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?:\\.?[A-Za-z0-9][A-Za-z0-9._/-]*)$"
            },
            "line": { "type": "integer", "minimum": 1 },
            "severity": { "enum": ["critical", "high", "medium", "low"] },
            "group": { "type": "integer", "minimum": 1, "maximum": 10 },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^(?:[^\\r\\n]+)$"
            },
            "body": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "required": ["path", "line", "severity", "group", "title", "body"]
        }
      },
      "residual_risk": { "type": "string", "minLength": 0, "maxLength": 2000 }
    },
    "required": ["summary", "findings", "residual_risk"]
  },
  "review": {
    "max_distinct_groups": 4
  },
  "provenance": {
    "path_must_be_changed_file": true,
    "line_must_be_in_diff_hunk": true
  },
  "markdown": {
    "review_fields": ["summary", "residual_risk"],
    "finding_fields": ["title", "body"],
    "plan_args": {
      "suggest": ["note"],
      "open_pr": ["title", "body"]
    },
    "allowed_nodes": [
      "text",
      "paragraph",
      "inline",
      "em",
      "strong",
      "code_inline",
      "code_block",
      "fence",
      "bullet_list",
      "ordered_list",
      "list_item",
      "softbreak",
      "hardbreak",
      "s"
    ],
    "link_host_allowlist": []
  },
  "plan": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                  "kind": { "const": "patch" },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?:\\.?[A-Za-z0-9][A-Za-z0-9._/-]*)$" },
                      "old": { "type": "string", "minLength": 1, "maxLength": 20000 },
                      "new": { "type": "string", "minLength": 0, "maxLength": 20000 }
                    },
                    "required": ["path", "old", "new"]
                  }
                },
                "required": ["id", "kind", "args"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                  "kind": { "const": "suggest" },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?:\\.?[A-Za-z0-9][A-Za-z0-9._/-]*)$" },
                      "line": { "type": "integer", "minimum": 1 },
                      "old": { "type": "string", "minLength": 1, "maxLength": 20000 },
                      "new": { "type": "string", "minLength": 0, "maxLength": 20000 },
                      "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
                    },
                    "required": ["path", "line", "old", "new", "note"]
                  }
                },
                "required": ["id", "kind", "args"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                  "kind": { "const": "push_branch" },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._/-]*)$" }
                    },
                    "required": ["name"]
                  }
                },
                "required": ["id", "kind", "args"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                  "kind": { "const": "open_pr" },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "branch": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._/-]*)$" },
                      "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?:[^\\r\\n]+)$" },
                      "body": { "type": "string", "minLength": 1, "maxLength": 4000 }
                    },
                    "required": ["branch", "title", "body"]
                  }
                },
                "required": ["id", "kind", "args"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                  "kind": { "const": "label" },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9 ._/-]*)$" }
                    },
                    "required": ["name"]
                  }
                },
                "required": ["id", "kind", "args"]
              }
            ]
          }
        }
      },
      "required": ["steps"]
    },
    "control_flow": [],
    "argument_forms": ["literal"],
    "step_kinds": {
      "patch": { "write_class": false },
      "suggest": { "write_class": false },
      "push_branch": { "write_class": true },
      "open_pr": { "write_class": true },
      "label": { "write_class": true }
    },
    "ordering": [
      { "before": "patch", "after": "push_branch" },
      { "before": "push_branch", "after": "open_pr" }
    ],
    "max_patched_files": 3,
    "max_changed_lines": 120,
    "max_changed_bytes": 8000,
    "max_plan_changed_bytes": 16000,
    "path_denylist": [
      ".github/**",
      "**/*.pem",
      "**/*.key"
    ],
    "branch_prefix": "aceiro/",
    "label_allowlist": []
  },
  "secret_scan_patterns": [
    "AKIA[0-9A-Z]{16}",
    "ASIA[0-9A-Z]{16}",
    "gh[pousr]_[A-Za-z0-9]{20,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{10,}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "xox[baprs]-[A-Za-z0-9-]{10,}",
    "(?i:aws_secret_access_key)\\s*[=:]\\s*[A-Za-z0-9/+=]{30,}"
  ]
}
